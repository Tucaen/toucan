# Keep text identical across Windows, WSL, and CI checkouts.
* text=auto eol=lf

# Never run line-ending conversion on binary assets.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.wasm binary
*.woff binary
*.woff2 binary
*.zip binary

# cmd.exe parses batch files line by line; keep their native endings.
*.cmd text eol=crlf
