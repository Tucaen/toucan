{
  "name": "toucan",
  "version": "0.17.10",
  "private": true,
  "description": "Toucan is a Windows-first agent development environment: a spatial canvas for terminal and coding-agent sessions.",
  "author": "Toucan contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tucaen/ade.git"
  },
  "bugs": "https://github.com/Tucaen/ade/issues",
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "repair-electron": "node node_modules/electron/install.js",
    "icon:generate": "node scripts/generate-app-icon.mjs",
    "icon:mobile": "node scripts/generate-mobile-icons.mjs",
    "voice:wer": "npm run build:test-out && node scripts/voice-wer.mjs",
    "build": "electron-vite build && npm run build:mobile",
    "start": "electron-vite preview",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"mobile/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,mjs}\" \"scripts/**/*.mjs\"",
    "lint": "eslint src tests mobile scripts *.ts *.mjs --max-warnings 0",
    "check:architecture": "depcruise --config dependency-cruiser.config.mjs src mobile",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json && tsc --noEmit -p tsconfig.shared.json",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm run typecheck && npm test",
    "check:full": "npm run check && npm run build",
    "test:watch": "vitest",
    "build:test-out": "tsc -p tsconfig.test.json",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win:installer": "npm run build && electron-builder --win nsis --x64",
    "package:win:portable": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --dir --win --x64",
    "publish:win": "electron-builder --win --x64 --publish always",
    "release": "node scripts/release.mjs",
    "build:mobile": "vite build --config mobile/vite.config.ts"
  },
  "build": {
    "appId": "dev.toucan.canvas",
    "productName": "Toucan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      ".agents/**/*"
    ],
    "asarUnpack": [
      "node_modules/npm/**/*",
      ".agents/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@openai/codex-win32-x64/**/*",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Toucan-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Toucan-${version}-portable-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Tucaen",
      "repo": "toucan-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.0",
    "@agentclientprotocol/codex-acp": "1.12.0",
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "npm": "11.19.1",
    "prettier": "^3.9.6",
    "ws": "^8.21.3"
  },
  "overrides": {
    "@openai/codex": "0.154.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@moonshine-ai/moonshine-wasm": "^0.1.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.2",
    "dependency-cruiser": "^18.2.0",
    "diff": "^9.0.0",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.38.0",
    "minimatch": "^10.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
