{
  "name": "ade-canvas-terminal-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first spatial canvas for terminal and coding-agent sessions.",
  "author": "ADE contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run prepare:voice-model",
    "dev": "electron-vite dev",
    "prepare:voice-model": "node scripts/prepare-voice-model.mjs",
    "check:voice-model": "node scripts/prepare-voice-model.mjs --check",
    "preprototype:voice": "npm run prepare:voice-model",
    "prototype:voice": "electron-vite dev",
    "prebuild": "npm run prepare:voice-model",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-out/tests/*.test.js && npm run test:dom",
    "test:terminal-events": "tsc -p tsconfig.test.json && node --test .test-out/tests/terminal-events.test.js",
    "test:dom": "vitest run",
    "test:dom:watch": "vitest",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --dir --win --x64"
  },
  "build": {
    "appId": "dev.ade.canvas",
    "productName": "ADE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@openai/codex-win32-x64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ADE-${version}-portable-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.66.0",
    "@agentclientprotocol/codex-acp": "1.1.10",
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@moonshine-ai/moonshine-wasm": "^0.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.2",
    "lowlight": "^3.3.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
