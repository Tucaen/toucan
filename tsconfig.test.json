{
  // Not a test compile any more: the suites run as ES modules under Vitest (#238). What survives is
  // `.test-out`, the CommonJS build the two manual live-verification scripts load -
  // `scripts/verify-outcome-retrieval.mjs` and `scripts/verify-session-fork.mjs` `await import()`
  // these entry points, and extensionless relative specifiers resolve only under CommonJS. The
  // include list is those two entries and nothing else; `tsc` pulls in whatever they import.
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    // `rootDir` is pinned so the emitted layout stays `.test-out/src/...`; tsc would otherwise infer
    // it from the common root of the include list and flatten the `src/` level the scripts name.
    "rootDir": ".",
    "outDir": ".test-out"
  },
  "include": ["src/main/acp-session-manager.ts", "src/shared/agent-transcript.ts"]
}
